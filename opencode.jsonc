{
  "$schema": "https://opencode.ai/config.json",

  // Keep the default coding agent, but make all access rules explicit below.
  "default_agent": "build",

  // AGENTS.md is auto-discovered. These add the human contributor and security
  // policies to the model context as well.
  "instructions": ["CONTRIBUTING.md", "SECURITY.md"],

  // Snapshots power /undo and /redo. They do not capture gitignored files, so
  // .env and other secret files must stay gitignored (see .gitignore).
  "snapshots": true,

  // Avoid watcher churn from generated and cache directories.
  "watcher": {
    "ignore": [
      ".venv/**",
      "__pycache__/**",
      "*.egg-info/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      ".mypy_cache/**",
      ".ipynb_checkpoints/**",
      "artifacts/**",
      "build/**",
      "dist/**",
      "htmlcov/**",
      ".coverage",
      "coverage.xml",
    ],
  },

  // Ordered rules: the last matching rule wins. The base policy is permissive,
  // so every broad rule here is followed by narrower allow/ask/deny rules.
  "permissions": [
    // ---------------------------------------------------------------------
    // Shell: ask by default, allow only routine inspection and quality gates.
    // ---------------------------------------------------------------------
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only Git inspection and branch preparation.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git switch -c *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout -b *", "effect": "allow" },

    // Local quality gates and builds.
    { "action": "shell", "resource": "uv sync *", "effect": "allow" },
    { "action": "shell", "resource": "uv lock *", "effect": "allow" },
    { "action": "shell", "resource": "uv build *", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
    { "action": "shell", "resource": "uv run python -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "uv run ruff *", "effect": "allow" },
    { "action": "shell", "resource": "uv run mypy *", "effect": "allow" },
    { "action": "shell", "resource": "uv run pre-commit *", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "ruff *", "effect": "allow" },
    { "action": "shell", "resource": "mypy *", "effect": "allow" },
    { "action": "shell", "resource": "pre-commit *", "effect": "allow" },

    // Read-only GitHub inspection.
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh run watch *", "effect": "allow" },
    { "action": "shell", "resource": "gh release list *", "effect": "allow" },
    { "action": "shell", "resource": "gh release view *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },

    // Harmless local inspection.
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },

    // Mutations and network operations require an explicit decision.
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git pull *", "effect": "ask" },
    { "action": "shell", "resource": "git tag *", "effect": "ask" },
    { "action": "shell", "resource": "git clone *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "gh release create *", "effect": "ask" },
    { "action": "shell", "resource": "gh release upload *", "effect": "ask" },
    { "action": "shell", "resource": "gh workflow run *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo clone *", "effect": "ask" },
    { "action": "shell", "resource": "uv pip *", "effect": "ask" },
    { "action": "shell", "resource": "uvx *", "effect": "ask" },
    { "action": "shell", "resource": "pip *", "effect": "ask" },
    { "action": "shell", "resource": "python *", "effect": "ask" },
    { "action": "shell", "resource": "python3 *", "effect": "ask" },
    { "action": "shell", "resource": "cp *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "mkdir *", "effect": "ask" },
    { "action": "shell", "resource": "touch *", "effect": "ask" },

    // Destructive, history-rewriting, or hook-bypassing Git operations.
    { "action": "shell", "resource": "git add -f *", "effect": "deny" },
    { "action": "shell", "resource": "git add --force *", "effect": "deny" },
    { "action": "shell", "resource": "git commit --no-verify *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout .", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git restore .", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -f *", "effect": "deny" },
    { "action": "shell", "resource": "git branch --force *", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d *", "effect": "deny" },
    { "action": "shell", "resource": "git tag -f *", "effect": "deny" },
    { "action": "shell", "resource": "git tag --force *", "effect": "deny" },
    { "action": "shell", "resource": "git stash clear *", "effect": "deny" },
    { "action": "shell", "resource": "git config *", "effect": "deny" },
    { "action": "shell", "resource": "git -c *", "effect": "deny" },
    { "action": "shell", "resource": "git credential *", "effect": "deny" },
    { "action": "shell", "resource": "git remote set-url *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "deny" },
    { "action": "shell", "resource": "git reflog expire *", "effect": "deny" },
    { "action": "shell", "resource": "git gc --prune=now *", "effect": "deny" },

    // Destructive GitHub or publishing operations. Normal push/PR/release
    // actions remain "ask" above so a maintainer can approve them explicitly.
    // Prevent spawning a new OpenCode process with weaker permissions.
    { "action": "shell", "resource": "opencode *", "effect": "deny" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "deny" },
    { "action": "shell", "resource": "gh release delete *", "effect": "deny" },
    { "action": "shell", "resource": "gh secret *", "effect": "deny" },
    { "action": "shell", "resource": "gh auth token *", "effect": "deny" },
    { "action": "shell", "resource": "gh auth login *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge --admin *", "effect": "deny" },
    { "action": "shell", "resource": "gh api -X DELETE *", "effect": "deny" },
    { "action": "shell", "resource": "gh api --method DELETE *", "effect": "deny" },
    { "action": "shell", "resource": "gh workflow disable *", "effect": "deny" },
    { "action": "shell", "resource": "gh workflow run publish *", "effect": "deny" },
    { "action": "shell", "resource": "uv publish *", "effect": "deny" },
    { "action": "shell", "resource": "twine upload *", "effect": "deny" },
    { "action": "shell", "resource": "python -m twine upload *", "effect": "deny" },

    // Privilege escalation and destructive host operations.
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "rmdir *", "effect": "deny" },
    { "action": "shell", "resource": "unlink *", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "chgrp *", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "diskutil *", "effect": "deny" },
    { "action": "shell", "resource": "kill *", "effect": "deny" },
    { "action": "shell", "resource": "pkill *", "effect": "deny" },
    { "action": "shell", "resource": "killall *", "effect": "deny" },
    { "action": "shell", "resource": "launchctl *", "effect": "deny" },
    { "action": "shell", "resource": "systemctl *", "effect": "deny" },
    { "action": "shell", "resource": "service *", "effect": "deny" },
    { "action": "shell", "resource": "defaults *", "effect": "deny" },
    { "action": "shell", "resource": "osascript *", "effect": "deny" },
    { "action": "shell", "resource": "open *", "effect": "deny" },
    { "action": "shell", "resource": "pbcopy *", "effect": "deny" },
    { "action": "shell", "resource": "pbpaste *", "effect": "deny" },

    // Credential stores and environment dumps.
    { "action": "shell", "resource": "security *", "effect": "deny" },
    { "action": "shell", "resource": "printenv *", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "set", "effect": "deny" },
    { "action": "shell", "resource": "set *", "effect": "deny" },
    { "action": "shell", "resource": "export *", "effect": "deny" },
    { "action": "shell", "resource": "history *", "effect": "deny" },
    { "action": "shell", "resource": "fc *", "effect": "deny" },
    { "action": "shell", "resource": "declare *", "effect": "deny" },
    { "action": "shell", "resource": "typeset *", "effect": "deny" },

    // Network egress from the shell. Use webfetch/websearch (both require
    // approval) or the dedicated GitHub commands instead.
    { "action": "shell", "resource": "ssh *", "effect": "deny" },
    { "action": "shell", "resource": "scp *", "effect": "deny" },
    { "action": "shell", "resource": "sftp *", "effect": "deny" },
    { "action": "shell", "resource": "rsync *", "effect": "deny" },
    { "action": "shell", "resource": "nc *", "effect": "deny" },
    { "action": "shell", "resource": "ncat *", "effect": "deny" },
    { "action": "shell", "resource": "telnet *", "effect": "deny" },
    { "action": "shell", "resource": "ftp *", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "deny" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "http *", "effect": "deny" },
    { "action": "shell", "resource": "https *", "effect": "deny" },
    { "action": "shell", "resource": "ssh-keygen *", "effect": "deny" },
    { "action": "shell", "resource": "openssl *", "effect": "deny" },
    { "action": "shell", "resource": "nmap *", "effect": "deny" },
    { "action": "shell", "resource": "docker *", "effect": "deny" },
    { "action": "shell", "resource": "podman *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl *", "effect": "deny" },
    { "action": "shell", "resource": "aws *", "effect": "deny" },
    { "action": "shell", "resource": "gcloud *", "effect": "deny" },
    { "action": "shell", "resource": "az *", "effect": "deny" },
    { "action": "shell", "resource": "terraform *", "effect": "deny" },
    { "action": "shell", "resource": "ansible *", "effect": "deny" },

    // File-reading and encoding tools are blocked in the shell. The read and
    // grep tools enforce path/regex permissions and are the intended interface.
    { "action": "shell", "resource": "cat *", "effect": "deny" },
    { "action": "shell", "resource": "head *", "effect": "deny" },
    { "action": "shell", "resource": "tail *", "effect": "deny" },
    { "action": "shell", "resource": "less *", "effect": "deny" },
    { "action": "shell", "resource": "more *", "effect": "deny" },
    { "action": "shell", "resource": "grep *", "effect": "deny" },
    { "action": "shell", "resource": "rg *", "effect": "deny" },
    { "action": "shell", "resource": "awk *", "effect": "deny" },
    { "action": "shell", "resource": "sed *", "effect": "deny" },
    { "action": "shell", "resource": "cut *", "effect": "deny" },
    { "action": "shell", "resource": "sort *", "effect": "deny" },
    { "action": "shell", "resource": "uniq *", "effect": "deny" },
    { "action": "shell", "resource": "tr *", "effect": "deny" },
    { "action": "shell", "resource": "base64 *", "effect": "deny" },
    { "action": "shell", "resource": "xxd *", "effect": "deny" },
    { "action": "shell", "resource": "od *", "effect": "deny" },
    { "action": "shell", "resource": "strings *", "effect": "deny" },
    { "action": "shell", "resource": "find *", "effect": "deny" },
    { "action": "shell", "resource": "xargs *", "effect": "deny" },

    // Shell/interpreter one-liners are common permission-bypass paths.
    { "action": "shell", "resource": "bash *", "effect": "deny" },
    { "action": "shell", "resource": "sh *", "effect": "deny" },
    { "action": "shell", "resource": "zsh *", "effect": "deny" },
    { "action": "shell", "resource": "fish *", "effect": "deny" },
    { "action": "shell", "resource": "ksh *", "effect": "deny" },
    { "action": "shell", "resource": "dash *", "effect": "deny" },
    { "action": "shell", "resource": "perl *", "effect": "deny" },
    { "action": "shell", "resource": "ruby *", "effect": "deny" },
    { "action": "shell", "resource": "node *", "effect": "deny" },
    { "action": "shell", "resource": "php *", "effect": "deny" },
    { "action": "shell", "resource": "eval *", "effect": "deny" },
    { "action": "shell", "resource": "exec *", "effect": "deny" },
    { "action": "shell", "resource": "source *", "effect": "deny" },
    { "action": "shell", "resource": "python -c *", "effect": "deny" },
    { "action": "shell", "resource": "python3 -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run python -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run python3 -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run * python -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run * python3 -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run * bash -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run * sh -c *", "effect": "deny" },
    { "action": "shell", "resource": "uv run * zsh -c *", "effect": "deny" },

    // ---------------------------------------------------------------------
    // Read: allow the project, deny secret material. `.env.example`-style
    // files remain readable because they contain no live credentials.
    // ---------------------------------------------------------------------
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "id_ecdsa*", "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "*/.config/gcloud/*", "effect": "deny" },
    { "action": "read", "resource": "*/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "*/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "*credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*service-account*.json", "effect": "deny" },
    { "action": "read", "resource": "*token.json", "effect": "deny" },
    { "action": "read", "resource": "*.git/*", "effect": "deny" },

    // ---------------------------------------------------------------------
    // Edit: allow normal source/docs edits, block secrets and generated files,
    // and require approval for guardrails, CI, and release configuration.
    // ---------------------------------------------------------------------
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.sample", "effect": "allow" },
    { "action": "edit", "resource": "*.env.template", "effect": "allow" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*.jks", "effect": "deny" },
    { "action": "edit", "resource": "*.keystore", "effect": "deny" },
    { "action": "edit", "resource": "*.git/*", "effect": "deny" },
    { "action": "edit", "resource": "*.venv/*", "effect": "deny" },
    { "action": "edit", "resource": "dist/*", "effect": "deny" },
    { "action": "edit", "resource": "build/*", "effect": "deny" },
    { "action": "edit", "resource": "*.egg-info/*", "effect": "deny" },
    { "action": "edit", "resource": "uv.lock", "effect": "deny" },
    { "action": "edit", "resource": ".github/workflows/*", "effect": "ask" },
    { "action": "edit", "resource": ".github/actions/*", "effect": "ask" },
    { "action": "edit", "resource": ".pre-commit-config.yaml", "effect": "ask" },
    { "action": "edit", "resource": "pyproject.toml", "effect": "ask" },
    { "action": "edit", "resource": ".gitignore", "effect": "ask" },
    { "action": "edit", "resource": "SECURITY.md", "effect": "ask" },
    { "action": "edit", "resource": "LICENSE", "effect": "ask" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/*", "effect": "ask" },

    // ---------------------------------------------------------------------
    // Discovery tools.
    // ---------------------------------------------------------------------
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "../*", "effect": "deny" },
    { "action": "glob", "resource": "/*", "effect": "deny" },
    { "action": "grep", "resource": "*", "effect": "ask" },

    // ---------------------------------------------------------------------
    // Subagents: only the known read-only/research agents.
    // ---------------------------------------------------------------------
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },
    { "action": "subagent", "resource": "reviewer", "effect": "allow" },
    { "action": "subagent", "resource": "general", "effect": "allow" },

    // ---------------------------------------------------------------------
    // Network and external filesystem access always require approval.
    // ---------------------------------------------------------------------
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Code Mode is disabled: its built-in fetch can bypass web approvals.
    // Use the normal read/grep/glob/edit/shell tools instead.
    { "action": "execute", "resource": "*", "effect": "deny" },

    // Skills are instructions only; integration policies below restrict which
    // skill IDs may load.
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
  ],

  // Policies are hard denials. They are evaluated after permissions and saved
  // approvals, so an "Allow always" choice cannot override them.
  "policies": [
    // Guardrail files are human-maintained. The agent must not rewrite its own
    // permissions, instructions, agents, or commands.
    { "action": "tool.use", "resource": "edit:opencode.jsonc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:AGENTS.md", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.opencode/*", "effect": "deny" },

    // Secret reads. The specific example-file allows lift the broad deny, then
    // the permission rules above decide; live .env files stay blocked.
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env.sample", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env.template", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.p12", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.jks", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.keystore", "effect": "deny" },
    { "action": "tool.use", "resource": "read:id_rsa*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:id_ed25519*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:id_ecdsa*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.aws/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/gcloud/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.npmrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.pypirc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.netrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.docker/config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*credentials.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*service-account*.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*token.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.git/*", "effect": "deny" },

    // Secret edits, with the same example-file exception.
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env.sample", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env.template", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.p12", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.jks", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.keystore", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:uv.lock", "effect": "deny" },

    // Privilege escalation and destructive host commands.
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:su *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:doas *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rmdir *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:unlink *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:chmod *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:chown *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:dd *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:mkfs *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:diskutil *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:kill *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pkill *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:killall *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:launchctl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:defaults *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:osascript *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pbcopy *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pbpaste *", "effect": "deny" },

    // Secret and environment disclosure.
    { "action": "tool.use", "resource": "shell:security *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:printenv*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:env*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:history*", "effect": "deny" },

    // File-reading and encoding commands are blocked in the shell; use read,
    // grep, and glob so path permissions are enforced.
    { "action": "tool.use", "resource": "shell:cat *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:head *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:tail *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:less *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:more *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:grep *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rg *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:awk *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sed *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cut *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sort *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uniq *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:tr *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:base64 *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:xxd *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:od *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:strings *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:find *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:xargs *", "effect": "deny" },

    // Shell and interpreter bypasses.
    { "action": "tool.use", "resource": "shell:bash *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sh *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:zsh *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:perl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ruby *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:eval *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:exec *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:source *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:python -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:python3 -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv run * python -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv run * python3 -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv run * bash -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv run * sh -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv run * zsh -c *", "effect": "deny" },

    // Network egress from the shell.
    { "action": "tool.use", "resource": "shell:ssh *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:scp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sftp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rsync *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:nc *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ncat *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:telnet *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ftp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:curl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:wget *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ssh-keygen *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:podman *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:kubectl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:aws *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gcloud *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:az *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:terraform *", "effect": "deny" },

    // Git history and hook bypasses.
    { "action": "tool.use", "resource": "shell:git add -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add --force *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit --no-verify *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --force *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset --hard *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout -- *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git restore .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -D *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch --force *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git tag -d *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git tag -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git tag --force *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash clear *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git config *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git credential *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git remote set-url *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-branch *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-repo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reflog expire *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git gc --prune=now *", "effect": "deny" },

    // GitHub/PyPI publish bypasses and destructive release operations.
    // Prevent spawning a new OpenCode process with weaker permissions.
    { "action": "tool.use", "resource": "shell:opencode *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh repo delete *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh release delete *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh secret *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh auth token *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh pr merge --admin *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh api -X DELETE *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh api --method DELETE *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh workflow disable *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh workflow run publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:twine upload *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:python -m twine upload *", "effect": "deny" },

    // Code Mode and unknown subagents.
    { "action": "tool.use", "resource": "execute:*", "effect": "deny" },
    { "action": "tool.use", "resource": "subagent:*", "effect": "deny" },
    { "action": "tool.use", "resource": "subagent:explore", "effect": "allow" },
    { "action": "tool.use", "resource": "subagent:reviewer", "effect": "allow" },
    { "action": "tool.use", "resource": "subagent:general", "effect": "allow" },

    // No MCP servers. Only the known built-in skills may load.
    { "action": "integration.use", "resource": "mcp:*", "effect": "deny" },
    { "action": "integration.use", "resource": "skill:*", "effect": "deny" },
    { "action": "integration.use", "resource": "skill:opencode", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:report", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:find-skills", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:node", "effect": "allow" },
  ],
}
